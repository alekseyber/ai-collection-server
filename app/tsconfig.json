{
  "compilerOptions": {
    "baseUrl": "./src",
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "services/*": ["./src/services/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
